<?xml version="1.0" encoding="UTF-8"?>

<!-- Desktop backdrop: XOR wallpaper generated by tools/make_wallpaper.py
     (deep slate gradient + teal X), installed to /usr/share/xor/. -->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="color-style" type="int" value="0"/>
        <property name="image-path" type="string" value="/usr/share/xor/wallpapers/xor-royal-aurora.jpg"/>
        <property name="image-show" type="bool" value="true"/>
        <property name="last-image" type="string" value="/usr/share/xor/wallpapers/xor-royal-aurora.jpg"/>
        <property name="last-single-image" type="string" value="/usr/share/xor/wallpapers/xor-royal-aurora.jpg"/>
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/xor/wallpapers/xor-royal-aurora.jpg"/>
        </property>
        <property name="workspace1" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/xor/wallpapers/xor-royal-aurora.jpg"/>
        </property>
      </property>
    </property>
  </property>
  <!-- Mark the XOR backdrop as already migrated.  Without this, xfdesktop's
       first-login migration resets the single-image keys to desktop-base. -->
  <property name="last-settings-migration-version" type="uint" value="1"/>
</channel>
