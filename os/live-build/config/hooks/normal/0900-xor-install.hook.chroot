#!/bin/sh
# Install XOR components staged into /opt/xor-dist by tools/build-iso.sh.
# Runs inside the chroot during `lb build`.  Fails loudly (set -e) if the
# staging step was skipped, so we never ship an image silently missing
# the broker.
set -eu

DIST=/opt/xor-dist
if [ ! -d "$DIST/broker" ]; then
    echo "ERROR: $DIST/broker missing - build via tools/build-iso.sh (it stages XOR sources)" >&2
    exit 1
fi

echo "Installing XOR broker + desktop components..."

# 1. Python sources under /usr/local/lib (kept out of Debian's paths).
install -d /usr/local/lib/xor-broker /usr/local/lib/xor-desktop /usr/local/lib/xor-assistant
cp -r "$DIST/broker/src/xor_broker" /usr/local/lib/xor-broker/
cp "$DIST/desktop/activity_core.py" "$DIST/desktop/xor_activity.py" /usr/local/lib/xor-desktop/
cp -r "$DIST/desktop/xor_shell" /usr/local/lib/xor-desktop/
cp -r "$DIST/assistant/src/xor_assistant" /usr/local/lib/xor-assistant/

# 2. Command wrappers on PATH.  The wrappers set PYTHONPATH explicitly;
#    there is no need for a .pth shim (and .pth files outside site-packages
#    are not processed by Python anyway).
cat > /usr/local/bin/xor-broker <<'EOF'
#!/bin/sh
exec env PYTHONPATH=/usr/local/lib/xor-broker python3 -m xor_broker.cli "$@"
EOF
cat > /usr/local/bin/xor-activity <<'EOF'
#!/bin/sh
exec env PYTHONPATH=/usr/local/lib/xor-desktop:/usr/local/lib/xor-broker python3 /usr/local/lib/xor-desktop/xor_activity.py "$@"
EOF
cat > /usr/local/bin/xor-shell <<'EOF'
#!/bin/sh
exec env PYTHONPATH=/usr/local/lib/xor-desktop:/usr/local/lib/xor-broker python3 -m xor_shell "$@"
EOF
cat > /usr/local/bin/xor-control-center <<'EOF'
#!/bin/sh
exec env PYTHONPATH=/usr/local/lib/xor-desktop:/usr/local/lib/xor-broker python3 -m xor_shell.control_center "$@"
EOF
install -m 0755 "$DIST/desktop/scripts/xor-shell-autostart.sh" /usr/local/bin/xor-shell-autostart
install -m 0755 "$DIST/desktop/scripts/xor-broker-autostart.sh" /usr/local/bin/xor-broker-autostart
install -m 0755 "$DIST/desktop/scripts/xor-broker-demo-run.sh" /usr/local/bin/xor-broker-demo-run
install -d /usr/local/lib/xor-broker/examples
install -m 0644 "$DIST/broker/examples/demo_reader.py" \
    "$DIST/broker/examples/demo_writer.py" /usr/local/lib/xor-broker/examples/
# Demo tools get the same PYTHONPATH wrapper treatment as the other
# commands.  Do not sed an import into the examples: inserting it after
# the shebang would displace the module docstring, and inserting it
# before the shebang makes the file unrunnable.
cat > /usr/local/bin/xor-demo-reader <<'EOF'
#!/bin/sh
exec env PYTHONPATH=/usr/local/lib/xor-broker python3 /usr/local/lib/xor-broker/examples/demo_reader.py "$@"
EOF
cat > /usr/local/bin/xor-demo-writer <<'EOF'
#!/bin/sh
exec env PYTHONPATH=/usr/local/lib/xor-broker python3 /usr/local/lib/xor-broker/examples/demo_writer.py "$@"
EOF
chmod 0755 /usr/local/bin/xor-broker /usr/local/bin/xor-activity /usr/local/bin/xor-shell /usr/local/bin/xor-control-center \
    /usr/local/bin/xor-demo-reader /usr/local/bin/xor-demo-writer

# 3. Menu entries + session autostart of the per-user broker daemon.
install -m 0644 "$DIST/desktop/applications/xor-broker-demo.desktop" /usr/share/applications/
install -m 0644 "$DIST/desktop/applications/xor-activity.desktop" /usr/share/applications/
install -m 0644 "$DIST/desktop/applications/xor-shell.desktop" /usr/share/applications/
install -m 0644 "$DIST/desktop/applications/xor-shell-launcher.desktop" /usr/share/applications/
install -m 0644 "$DIST/desktop/applications/xor-control-center.desktop" /usr/share/applications/
install -d /etc/xdg/autostart
install -m 0644 "$DIST/desktop/applications/xor-broker-autostart.desktop" /etc/xdg/autostart/
install -m 0644 "$DIST/desktop/applications/xor-shell-autostart.desktop" /etc/xdg/autostart/

# 4. Branding: wallpapers, logo + XFCE defaults for every new user (skel).
install -d /usr/share/xor/wallpapers /usr/share/icons/hicolor/scalable/apps
install -m 0644 "$DIST/desktop/theme/wallpaper.png" /usr/share/xor/wallpaper.png
install -m 0644 "$DIST/desktop/theme/wallpapers/"* /usr/share/xor/wallpapers/
install -m 0644 "$DIST/desktop/theme/xor-logo.svg" /usr/share/xor/xor-logo.svg
install -m 0644 "$DIST/desktop/theme/xor-logo.svg" /usr/share/icons/hicolor/scalable/apps/xor-logo.svg
install -d /etc/skel/.config
cp -r "$DIST/desktop/theme/xfce4" /etc/skel/.config/

# 5. Identity.
printf 'XOR OS 0.2 (Aurora preview) - Debian trixie based\n' > /etc/xor-release

# 6. Sanity: installed components must import and their headless status paths
#    must run.  (Full security corpus runs in CI, not here.)
PYTHONPATH=/usr/local/lib/xor-broker python3 -c "import xor_broker; print('xor_broker', xor_broker.__version__)"
PYTHONPATH=/usr/local/lib/xor-desktop:/usr/local/lib/xor-broker python3 -c "import activity_core, xor_shell.core; print('desktop cores OK')"
PYTHONPATH=/usr/local/lib/xor-desktop:/usr/local/lib/xor-broker python3 -m xor_shell --status-json >/dev/null
PYTHONPATH=/usr/local/lib/xor-desktop:/usr/local/lib/xor-broker python3 -m xor_shell.control_center --text >/dev/null

echo "XOR components installed."
